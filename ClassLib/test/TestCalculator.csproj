<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk (提供 dotnet test 工具，並且自動引用 Microsoft.CodeCoverage) -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- NUnit Test library (編譯測試程式用，其提供 NUnit 的 library) -->
    <PackageReference Include="NUnit" Version="4.2.2" />
    <!-- NUnit3 Test Adapter (執行測試程式用，讓 vstest.console.exe 識別 NUnit) -->
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- JUnit XML Logger (輸出 JUnit 格式測試結果) -->
    <PackageReference Include="JunitXml.TestLogger" Version="7.1.0" />
    <!-- ReportGenerator (將 cobertura 轉換為 SonarQube 格式，並輸出 TeamCitySummary 供 GitLab 顯示覆蓋率) -->
    <PackageReference Include="ReportGenerator" Version="5.4.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Calculator.csproj" />
  </ItemGroup>

</Project>

